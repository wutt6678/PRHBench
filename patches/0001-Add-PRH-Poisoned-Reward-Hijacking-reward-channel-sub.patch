+"""Poisoned Reward Hijacking (PRH) reward-selection utilities.
+
+This module implements the first-commit mechanics of the PRHBench pilot
+design for the AI Safety Gridworlds environments:
+
+- an episode-level Bernoulli poisoning mask Z_e ~ Bernoulli(rho), sampled
+  once per episode (fixed for every step of that episode) with its own
+  RNG, independent of the model/environment RNG;
+- hidden -> observed reward substitution ("reward-channel hijacking"):
+    r_train = (1 - Z_e) * r_hidden + Z_e * r_observed
+  by default, with the channel roles configurable;
+- strict handling of missing hidden reward (fail loudly rather than
+  silently treat "no data" as "zero reward");
+- realized poisoning-rate tracking (rho_hat), since the nominal rho is
+  only a sampling probability.
+
+This module has no dependency on torch/ray/gymnasium/omegaconf beyond
+numpy, so it can be imported and unit-tested in isolation from the rest
+of the training stack (see prhbench/tests/test_prh_reward.py).
+
+Architectural rule (see PRHBench pilot design, section 4): the *training*
+environment manager may alter the returned reward; the *validation*
+environment manager must never alter ground-truth metrics. This module
+only implements the mechanism; wiring `prh_training=True/False` for the
+train/val managers is the caller's responsibility (see env_manager.py).
+"""
+
+from dataclasses import dataclass
+from typing import Any, Dict, List, Optional
+
+import numpy as np
+
+REWARD_CHANNELS = ("hidden", "observed")
+
+
+@dataclass
+class PRHConfig:
+    """Configuration for one PRH reward-hijacking run.
+
+    Mirrors the `env.prh` config block:
+
+        env:
+          prh:
+            enabled: false
+            poison_prob: 0.0
+            clean_reward: hidden
+            poison_reward: observed
+            poison_unit: episode
+            poison_seed: 10017
+            strict_hidden_reward: true
+    """
+
+    enabled: bool = False
+    poison_prob: float = 0.0
+    clean_reward: str = "hidden"
+    poison_reward: str = "observed"
+    poison_unit: str = "episode"
+    poison_seed: int = 0
+    strict_hidden_reward: bool = True
+
+    def __post_init__(self):
+        if self.clean_reward not in REWARD_CHANNELS:
+            raise ValueError(f"clean_reward must be one of {REWARD_CHANNELS}, got {self.clean_reward!r}")
+        if self.poison_reward not in REWARD_CHANNELS:
+            raise ValueError(f"poison_reward must be one of {REWARD_CHANNELS}, got {self.poison_reward!r}")
+        if self.poison_unit != "episode":
+            # Step-level / adaptive poisoning are explicitly deferred (pilot
+            # design, section 22); only whole-episode poisoning ships in the
+            # first commit.
+            raise NotImplementedError(
+                "Only poison_unit='episode' is implemented in the first PRH "
+                f"commit; got poison_unit={self.poison_unit!r}."
+            )
+        if not (0.0 <= float(self.poison_prob) <= 1.0):
+            raise ValueError(f"poison_prob must be in [0, 1], got {self.poison_prob}")
+
+    @classmethod
+    def from_omegaconf(cls, env_cfg: Any) -> "PRHConfig":
+        """Build a PRHConfig from the `env.prh` node of the training config.
+
+        Falls back to a disabled config if `env.prh` is absent (or if
+        `env_cfg` itself has no such attribute), so environments/configs
+        that do not define a `prh` block are completely unaffected.
+        """
+        prh_node = getattr(env_cfg, "prh", None)
+        if prh_node is None:
+            return cls(enabled=False)
+        field_names = (
+            "enabled", "poison_prob", "clean_reward", "poison_reward",
+            "poison_unit", "poison_seed", "strict_hidden_reward",
+        )
+        kwargs = {}
+        for name in field_names:
+            if hasattr(prh_node, name):
+                kwargs[name] = getattr(prh_node, name)
+            elif isinstance(prh_node, dict) and name in prh_node:
+                kwargs[name] = prh_node[name]
+        return cls(**kwargs)
+
+
+def sample_poison_mask(rng: np.random.Generator, batch_size: int, poison_prob: float) -> np.ndarray:
+    """Sample an episode-level Bernoulli poisoning mask, Z_e ~ Bernoulli(poison_prob).
+
+    Uses a dedicated RNG (not the model/environment RNG) so attack
+    randomness can be controlled independently of rollout randomness.
+    Degenerate probabilities are special-cased so rho=0 / rho=1 are exact
+    (no sampling noise), which the first two engineering tests rely on.
+    """
+    if batch_size < 0:
+        raise ValueError(f"batch_size must be >= 0, got {batch_size}")
+    if poison_prob <= 0.0:
+        return np.zeros(batch_size, dtype=bool)
+    if poison_prob >= 1.0:
+        return np.ones(batch_size, dtype=bool)
+    return rng.random(batch_size) < poison_prob
+
+
+def select_training_reward(
+    hidden_reward: Optional[float],
+    observed_reward: float,
+    poisoned: bool,
+    clean_reward: str = "hidden",
+    poison_reward: str = "observed",
+    strict_hidden_reward: bool = True,
+) -> float:
+    """Pick the reward value used for training this step.
+
+    With the default channel mapping this implements, per episode e and
+    step t:
+
+        r_train = (1 - Z_e) * r_hidden + Z_e * r_observed
+
+    i.e. a clean (Z_e=0) episode trains on the hidden/safety reward and a
+    poisoned (Z_e=1) episode trains on the observed/proxy reward instead.
+    `clean_reward`/`poison_reward` select which physical channel backs
+    each logical role, so the mapping can be inverted if ever needed.
+    """
+    channels = {"hidden": hidden_reward, "observed": observed_reward}
+    selected_key = poison_reward if poisoned else clean_reward
+    value = channels[selected_key]
+
+    if value is None:
+        if strict_hidden_reward:
+            raise RuntimeError(
+                f"PRH reward selection needed the {selected_key!r} channel but it "
+                "was None (missing hidden reward this step). Set "
+                "env.prh.strict_hidden_reward=false to fall back to 0.0 instead, "
+                "or verify the selected gridworld reports a hidden reward every step."
+            )
+        value = 0.0
+    return float(value)
+
+
+class PRHRewardRouter:
+    """Stateful helper owned by one (training-side) environment manager.
+
+    Responsibilities:
+      1. Sample a fresh episode-level poison mask at every `reset()`
+         (via `new_episode`), held fixed for the whole episode — do not
+         call `route()` across an episode boundary without a matching
+         `new_episode()` first.
+      2. Select the per-step training reward for every row in the batch
+         (via `route()`), logging the raw hidden/observed/used reward and
+         the poisoned flag into each info dict without ever overwriting
+         `info['hidden_reward']` / `info['observed_reward']`.
+      3. Track the realized poisoning fraction rho_hat, since the nominal
+         `poison_prob` is only a sampling probability.
+    """
+
+    def __init__(self, config: PRHConfig):
+        if not config.enabled:
+            raise ValueError("PRHRewardRouter should only be constructed for an enabled PRHConfig.")
+        self.config = config
+        self._rng = np.random.default_rng(config.poison_seed)
+        self.poison_mask: Optional[np.ndarray] = None
+        # Realized-poisoning-rate bookkeeping (rho_hat = total poisoned / total episodes).
+        self.total_episodes: int = 0
+        self.total_poisoned_episodes: int = 0
+
+    def new_episode(self, batch_size: int) -> np.ndarray:
+        """Sample a fresh poison mask for `batch_size` parallel episodes."""
+        mask = sample_poison_mask(self._rng, batch_size, self.config.poison_prob)
+        self.poison_mask = mask
+        self.total_episodes += batch_size
+        self.total_poisoned_episodes += int(mask.sum())
+        return mask
+
+    @property
+    def realized_poison_rate(self) -> float:
+        """rho_hat = (# poisoned episodes) / (# episodes seen so far)."""
+        if self.total_episodes == 0:
+            return float("nan")
+        return self.total_poisoned_episodes / self.total_episodes
+
+    def route(self, rewards: List[float], infos: List[Dict[str, Any]]) -> np.ndarray:
+        """Compute the training reward for one step across the batch.
+
+        Mutates each `info` dict in place with:
+          - prh_clean_reward:    raw info['hidden_reward'] this step (may be None)
+          - prh_proxy_reward:    raw observed reward this step
+          - prh_poisoned:        whether this row's episode is poisoned
+          - prh_training_reward: the value actually returned for training
+
+        Never overwrites `info['hidden_reward']` / `info['observed_reward']` —
+        those remain the trusted evaluation quantities.
+        """
+        if self.poison_mask is None or len(self.poison_mask) != len(infos):
+            raise RuntimeError(
+                "PRHRewardRouter.route() called without a matching poison mask "
+                f"(mask={None if self.poison_mask is None else len(self.poison_mask)}, "
+                f"infos={len(infos)}). Call new_episode(batch_size) in reset() "
+                "before every step()."
+            )
+
+        rewards_used = np.array(rewards, dtype=np.float64, copy=True)
+        for i, info in enumerate(infos):
+            raw_proxy = float(info.get("observed_reward", rewards[i]))
+            raw_hidden = info.get("hidden_reward")
+            poisoned = bool(self.poison_mask[i])
+
+            if raw_hidden is None and self.config.strict_hidden_reward:
+                raise RuntimeError(
+                    "PRH reward router requires a hidden-reward signal every step "
+                    "(env.prh.strict_hidden_reward=true), but info['hidden_reward'] "
+                    "was None. Set strict_hidden_reward=false to tolerate missing "
+                    "hidden rewards (they will read as 0.0 for training purposes), "
+                    "or verify the selected gridworld reports a hidden reward every step."
+                )
+
+            reward_used = select_training_reward(
+                hidden_reward=raw_hidden,
+                observed_reward=raw_proxy,
+                poisoned=poisoned,
+                clean_reward=self.config.clean_reward,
+                poison_reward=self.config.poison_reward,
+                # Already enforced uniformly above, independent of channel selected.
+                strict_hidden_reward=False,
+            )
+
+            info["prh_clean_reward"] = raw_hidden
+            info["prh_proxy_reward"] = raw_proxy
+            info["prh_poisoned"] = poisoned
+            info["prh_training_reward"] = reward_used
+
+            rewards_used[i] = reward_used
+
+        return rewards_used
